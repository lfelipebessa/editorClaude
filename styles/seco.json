{
  "name": "seco",
  "description": "Jump cut agressivo estilo rede social — padrão do canal. Ajustes de gosto editam ESTE arquivo, nunca o código.",
  "language": "pt",
  "cut": {
    "trim_start": 0.07,
    "trim_end": 0.12,
    "trim_min_duration": 0.8,
    "trim_max_fraction": 0.12,
    "trim_max_word_fraction": 0.3,
    "min_word_protect": 0.4,
    "short_word_end_margin": 0.5,
    "max_word_gap": 0.25,
    "pad_before": 0.0,
    "pad_after": 0.0,
    "min_segment": 0.2
  },
  "color": {
    "scope": "camera",
    "lut": null,
    "lut_note": "Footage atual do Osmo Pocket 3 é perfil Normal (Rec.709) — LUT não se aplica. Se gravar em D-Log M, baixar a LUT oficial 'D-Log M to Rec.709' em https://www.dji.com/downloads/softwares/osmo-pocket-3-dlog-to-rec709, salvar em assets/luts/ e apontar o campo lut para ela.",
    "adjust": {
      "exposure_ev": 0.05,
      "contrast": 1.06,
      "saturation": 1.16,
      "gamma": 1.0
    }
  },
  "audio": {
    "target_i": -14.0,
    "target_tp": -1.5,
    "target_lra": 7.0,
    "limiter": {
      "enabled": true,
      "limit_db": -1.5,
      "attack_ms": 5,
      "release_ms": 100
    }
  },
  "platforms": {
    "youtube": {
      "aspect": "16:9",
      "transform": "none"
    },
    "instagram": {
      "aspect": "9:16",
      "width": 1080,
      "height": 1920,
      "crop": "center",
      "crop_x_offset": 0
    },
    "tiktok": {
      "aspect": "9:16",
      "width": 1080,
      "height": 1920,
      "crop": "center",
      "crop_x_offset": 0
    }
  }
}
